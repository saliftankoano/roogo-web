CLERK_SECRET_KEY=
CORS_ORIGIN=http://localhost:19006

# ==============================================================================
# PAWAPAY PAYMENT CONFIGURATION
# ==============================================================================

# Local mode toggle: Controls which PawaPay environment to use in local development
# Options: 'sandbox' (default, no real money) or 'live' (real money with dev pricing)
# Production always uses live regardless of this setting
PAWAPAY_LOCAL_MODE=sandbox

# Sandbox credentials (testing without real money)
PAWAPAY_SANDBOX_URL=https://api.sandbox.pawapay.io
PAWAPAY_SANDBOX_API_TOKEN=your_sandbox_token_here

# Live credentials (real money transactions)
PAWAPAY_LIVE_URL=https://api.pawapay.io
PAWAPAY_LIVE_API_TOKEN=your_live_token_here

# Legacy fallback (backward compatibility - will use mode-specific vars if available)
PAWAPAY_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=your_token_here

# Payment page return URL (where users return after payment)
PAWAPAY_PAYMENTPAGE_RETURN_URL=http://localhost:3000/payments/callback

# Meta Pixel (Facebook) - optional, leave empty to disable tracking
NEXT_PUBLIC_META_PIXEL_ID=

# ==============================================================================
# CLERK (server-side webhook)
# ==============================================================================

# Signing secret from Clerk dashboard → Webhooks (whsec_...)
CLERK_WEBHOOK_SECRET=

# ==============================================================================
# SUPABASE (server-side)
# ==============================================================================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# REDIS (Upstash — rate limiting)
# ==============================================================================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# CRON AUTHENTICATION
# ==============================================================================

# Shared secret required in Authorization header for /api/cron/* routes
CRON_SECRET=

# ==============================================================================
# STAFF REGISTRATION
# ==============================================================================

# Secret code handed to staff members to complete signup via /api/auth/verify-staff-code
STAFF_REGISTRATION_SECRET=

# ==============================================================================
# PUBLIC RUNTIME
# ==============================================================================

# Base URL of this app — used to build absolute callback/redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ==============================================================================
# SUPPORT CONTACT (fallbacks used in templated emails / decline flow)
# ==============================================================================

SUPPORT_PHONE=+22600000000
SUPPORT_WHATSAPP=+22600000000

# ==============================================================================
# DEV PRICING OVERRIDES (optional, local development only)
# ==============================================================================

# Set to "true" to replace live pricing with the override values below.
# See README.md "Dev pricing overrides" for the full matrix.
DEV_PRICING_OVERRIDE=false
DEV_TIER_PRICE=
DEV_COMMISSION_PERCENTAGE=
DEV_ADDON_PRICE=
